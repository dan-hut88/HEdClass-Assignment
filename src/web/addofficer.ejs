<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Officer — HEdClass</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="/myUI.css" rel="stylesheet">
</head>

<body class="bg-light">

    <nav class="navbar bg-dark border-bottom border-body px-4" data-bs-theme="dark">
        <a class="navbar-brand fw-bold" href="/registry">Dashboard</a>
        <div class="d-flex align-items-center gap-3">
            <a href="/logout" class="btn btn-outline-light btn-sm">Logout</a>
        </div>
    </nav>

    
    <div class="registry_body">
        <div class="registry_container">
            <h3>Add officer</h3>
            <p>Add a new classifications officer</p>

            <div class="degreeForm">
                <form action="/registry/officers/add" method="post">
                    <div class="mb-3">
                        <label class="form-label">Full name</label>
                        <input type="text" name="name" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email address</label>
                        <input type="email" name="email" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input type="password" name="password" class="form-control" required>
                    </div>
                    <div class="registry_buttons">
                        <button type="submit" class="btn btn-primary">Add officer</button>
                        <a href="/registry" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>


            </div>
        </div>
    </div>
    

</body>

</html>