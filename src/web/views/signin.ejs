<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head', { title: 'Sign in' }) %>
</head>

<body>

    <%- include('partials/flash') %>

    <div class="d-flex justify-content-center align-items-center vh-100">
        <div class="card shadow-sm p-4" style="width: 100%; max-width: 500px;">
            <div class="card-body">
                <img src="https://usfolk.co.uk/wp-content/uploads/2020/05/queens-university-belfast-logo.png" alt="logo"
                    class="img-fluid">
                <h2 class="card-title text-center mb-4">Sign In</h2>

                <form action="/" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Email address</label>
                        <input type="email" name="emailField" class="form-control" placeholder="name@example.com" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input type="password" name="passwordField" class="form-control" required>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Login</button>
                </form>
            </div>
        </div>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</body>

</html>
