<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head', { title: 'Edit officer' }) %>
</head>

<body class="bg-light">

    <%- include('partials/navbar', { dashboardHref: '/registry' }) %>
    <%- include('partials/flash') %>

    <div class="registry_body">
        <div class="registry_container">
            <h3>Edit officer</h3>
            <p>Edit officer information</p>


            <div class=officerForm>
                <form action="/registry/officers/<%= officer.id %>/edit" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Full name</label>
                        <input type="text" name="name" value="<%= officer.name %>" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email address</label>
                        <input type="email" name="email" value="<%= officer.email %>" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Assigned degrees</label>
                        <% degrees.forEach(degree=> { %>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="degrees" value="<%= degree.id %>"
                                    <%=assignedIds.includes(degree.id) ? "checked" : "" %>
                                >
                                <label class="form-check-label">
                                    <%= degree.name %>
                                </label>
                            </div>
                            <% }) %>
                    </div>
                    <div class="registry_buttons">
                        <button type="submit" class="btn btn-primary">Save changes</button>
                        <a href="/registry" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>

</body>

</html>
