<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head', { title: 'Add officer' }) %>
</head>

<body class="bg-light">

    <%- include('partials/navbar', { dashboardHref: '/registry' }) %>
    <%- include('partials/flash') %>

    <div class="registry_body">
        <div class="registry_container">
            <h3>Add officer</h3>
            <p>Add a new classifications officer</p>

            <div class="degreeForm">
                <form action="/registry/officers/add" method="post">
                    <div class="mb-3">
                        <label class="form-label">Full name</label>
                        <input type="text" name="name" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email address</label>
                        <input type="email" name="email" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input type="password" name="password" class="form-control" required>
                    </div>
                    <div class="registry_buttons">
                        <button type="submit" class="btn btn-primary">Add officer</button>
                        <a href="/registry" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>


            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>

</body>

</html>
