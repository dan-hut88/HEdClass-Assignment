<% if (flash) { %>
    <div class="container-fluid px-4 pt-3">
        <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show"
            role="alert">
            <%= flash.message %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
<% } %>
