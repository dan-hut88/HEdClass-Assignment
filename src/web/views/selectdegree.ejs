<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head', { title: 'Select degree' }) %>
</head>

<body>

    <%- include('partials/navbar', { dashboardHref: '/select-degree' }) %>
    <%- include('partials/flash') %>

    <div class="registry_body">
        <div class="registry_container">
            <h3>Welcome</h3>
            <p>Which degree would you like to work on?</p>

            <div class="registry_buttons">
                <% degrees.forEach(degree=> { %>
                    <form method="POST" action="/select-degree">
                        <input type="hidden" name="degree_id" value="<%= degree.id %>">
                        <button type="submit" class="btn btn-primary">
                            <%= degree.name %>
                        </button>
                    </form>
                    <% }) %>
            </div>


        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>




</body>

</html>
