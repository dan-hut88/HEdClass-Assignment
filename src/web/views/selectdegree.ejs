<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Select Degree</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link href="/myUI.css" rel="stylesheet">
</head>

<body>

  <nav class="navbar bg-dark border-bottom border-body px-4" data-bs-theme="dark">
    <a class="navbar-brand fw-bold" href="/select-degree">Dashboard</a>
    <div class="d-flex align-items-center gap-3">
      <a href="/logout" class="btn btn-outline-light btn-sm">Logout</a>
    </div>
  </nav>

  <div class="registry_body">
    <div class="registry_container">
      <h3>Welcome</h3>
      <p>Which degree would you like to work on?</p>

      <div class="registry_buttons">
        <% degrees.forEach(degree=> { %>
          <form method="POST" action="/select-degree">
            <input type="hidden" name="degree_id" value="<%= degree.id %>">
            <button type="submit" class="btn btn-primary">
              <%= degree.name %>
            </button>
          </form>
          <% }) %>
      </div>


    </div>

  </div>


  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>




</body>

</html>