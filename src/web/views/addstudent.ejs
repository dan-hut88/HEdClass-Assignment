<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add student</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="/myUI.css" rel="stylesheet">
</head>

<body class="bg-light">

    <nav class="navbar bg-dark border-bottom border-body px-4" data-bs-theme="dark">
        <a class="navbar-brand fw-bold" href="/classifications">Dashboard</a>
        <div class="d-flex align-items-center gap-3">
            <a href="/logout" class="btn btn-outline-light btn-sm">Logout</a>
        </div>
    </nav>



    <div class="classification_body">
        <div class="classification_container">
            <h3>Add student</h3>
            <p>Add a new student record</p>

            <div class="degreeForm">
                <form action="/classifications/students/add" method="post">
                    <div class="classification_card">
                        <p class="cardTitle">Student details</p>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">First name</label>
                                <input type="text" name="firstName" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Last name</label>
                                <input type="name" name="lastName" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Student number</label>
                                <input type="number" name="snumber" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Entry year</label>
                                <input type="number" name="year" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Academic year</label>
                                <input type="text" name="academicYear" class="form-control" placeholder="2024/25" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Degree</label>
                                <input type="hidden" name="degrees" value="<%= degree.id %>">
                                <p>
                                    <%= degree.name %>
                                </p>
                            </div>
                        </div>

                    </div>

                    <div class="classification_card">
                        <p class="cardTitle">Year 1 modules</p>
                        <div class="moduleHeader">
                            <span>Module name</span>
                            <span>Mark</span>
                            <span style="text-align: center;">Resit</span>
                        </div>
                        <div class="yr1Modules">
                            <% modules1.forEach(module=> { %>
                                <div class="moduleRows">
                                    <span>
                                        <%= module.module_name %>
                                    </span>
                                    <input type="hidden" name="moduleIds[]" value="<%= module.id %>">
                                    <input type="number" step="0.1" name="marks[]" required>
                                    <input type="checkbox" name="isResit[]" value="<%= module.id %>">
                                </div>
                                <% }) %>
                        </div>
                    </div>


                    <div class="classification_card">
                        <p class="cardTitle">Year 2 modules</p>
                        <div class="moduleHeader">
                            <span>Module name</span>
                            <span>Mark</span>
                            <span style="text-align: center;">Resit</span>
                        </div>
                        <div class="yr2Modules">

                            <% modules2.forEach(module=> { %>
                                <div class="moduleRows">
                                    <label class="form-label">
                                        <%= module.module_name %>
                                    </label>
                                    <input type="hidden" name="moduleIds[]" value="<%= module.id %>">
                                    <input type="number" step="0.1" name="marks[]" required>
                                    <input type="checkbox" name="isResit[]" value="<%= module.id %>">
                                </div>
                                <% }) %>

                        </div>
                    </div>


                    <div class="classification_card">
                        <p class="cardTitle">Year 3 modules</p>
                        <div class="moduleHeader">
                            <span>Module name</span>
                            <span>Mark</span>
                            <span style="text-align: center;">Resit</span>
                        </div>
                    <div class="yr3Modules">

                        <% modules3.forEach(module=> { %>
                            <div class="moduleRows">
                                <label class="form-label">
                                    <%= module.module_name %>
                                </label>
                                <input type="hidden" name="moduleIds[]" value="<%= module.id %>">
                                <input type="number" step="0.1" name="marks[]" required>
                                <input type="checkbox" name="isResit[]" value="<%= module.id %>">
                            </div>
                            <% }) %>

                    </div>
                    </div>

                    <div class="classification_buttons">
                        <button type="submit" class="btn btn-primary">Add student</button>
                        <a href="/classifications" class="btn btn-outline-secondary">Cancel</a>
                    </div>

                </form>
            </div>

        </div>
    </div>




</body>

</html>