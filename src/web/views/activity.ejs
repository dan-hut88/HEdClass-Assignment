<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head', { title: 'Activity' }) %>
</head>

<body class="bg-light">

    <%- include('partials/navbar', { dashboardHref: '/classifications' }) %>
    <%- include('partials/flash') %>

    <div class="container py-4">

        <div class="mb-4">
            <h2>Activity</h2>
            <p class="text-muted mb-0">Your recent classification actions</p>
        </div>

        <div class="card border shadow-sm mb-4">
            <div class="card-body">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>When</th>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody class="table-group-divider">
                        <% if (activity.length===0) { %>
                            <tr>
                                <td colspan="4" class="text-muted small">No activity recorded yet.</td>
                            </tr>
                            <% } %>
                                <% activity.forEach(entry=> { %>
                                    <tr>
                                        <td class="text-muted small">
                                            <%= new Date(entry.created_at).toLocaleString() %>
                                        </td>
                                        <td>
                                            <%= entry.action %>
                                        </td>
                                        <td>
                                            <%= entry.entity %> #<%= entry.entity_id %>
                                        </td>
                                        <td>
                                            <%= entry.details %>
                                        </td>
                                    </tr>
                                    <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <a href="/classifications" class="btn btn-outline-secondary">Back to dashboard</a>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>

</body>

</html>
