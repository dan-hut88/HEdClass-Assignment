<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head', { title: 'Edit degree' }) %>
</head>

<body>

    <%- include('partials/navbar', { dashboardHref: '/registry' }) %>
    <%- include('partials/flash') %>

    <div class="registry_body">
        <div class="registry_container">
            <h3>Edit degree</h3>
            <p>Edit degree information</p>

            <div class="degreeForm">
                <form action="/registry/degrees/<%= degree.id %>/edit" method="post">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" name="name" value="<%= degree.name %>" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Yr 2 weighting</label>
                        <input type="number" name="yr2_weight" value="<%= degree.weighting_yr2 %>" class="form-control"
                            min="0" max="100" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Yr 3 weighting</label>
                        <input type="number" name="yr3_weight" value="<%= degree.weighting_yr3 %>" class="form-control"
                            min="0" max="100" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Credits per year</label>
                        <input type="number" name="credits" value="<%= degree.credits_per_year %>" class="form-control"
                            min="0" required>
                    </div>
                    <div class="registry_buttons">
                        <button type="submit" class="btn btn-primary">Edit degree</button>
                        <a href="/registry" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>


            </div>
        </div>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>

</body>

</html>
