<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Officer — HEdClass</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link href="/myUI.css" rel="stylesheet">
</head>

<body class="bg-light">

  <nav class="navbar bg-dark border-bottom border-body px-4" data-bs-theme="dark">

    <a class="navbar-brand fw-bold" href="/registry">Dashboard</a>
    <div class="d-flex align-items-center gap-3">

      <a href="/logout" class="btn btn-outline-light btn-sm">Logout</a>
    </div>
  </nav>

  <div class="registry_body" >
    <div class="registry_container">
      <h3>Edit degree</h3>
      <p>Edit degree information</p>


      <div class=officerForm>
        <form action="/registry/officers/<%= officer.id %>/edit" method="POST">
          <div class="mb-3">
            <label class="form-label">Full name</label>
            <input type="text" name="name" value="<%= officer.name %>" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Email address</label>
            <input type="email" name="email" value="<%= officer.email %>" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Assigned degrees</label>
            <% degrees.forEach(degree=> { %>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="degrees" value="<%= degree.id %>"
                  <%=assignedIds.includes(degree.id) ? "checked" : "" %>
                >
                <label class="form-check-label">
                  <%= degree.name %>
                </label>
              </div>
              <% }) %>
          </div>
          <div class="registry_buttons">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a href="/registry" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>

</body>

</html>