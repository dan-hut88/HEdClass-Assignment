<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registry officer dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>

    <nav class="navbar bg-dark border-bottom border-body px-4" data-bs-theme="dark">

        <a class="navbar-brand fw-bold" href="/registry">Dashboard</a>
        <div class="d-flex align-items-center gap-3">

            <a href="/logout" class="btn btn-outline-light btn-sm">Logout</a>
        </div>
    </nav>


    <div class="main body py-4 px-4">

        <div class="textInfo">
            <h2>Registry Services Dashboard</h2>
            <p>Manage officers, degrees and assignments</p>

        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border shadow-sm">
                    <div class="card-body">
                        <p class="text-muted small mb-1">Officers</p>
                        <p class="fs-3 fw-semibold mb-0">
                            <%= officers.length %>
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border shadow-sm">
                    <div class="card-body">
                        <p class="text-muted small mb-1">Degrees</p>
                        <p class="fs-3 fw-semibold mb-0">
                            <%= degrees.length %>
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border shadow-sm">
                    <div class="card-body">
                        <p class="text-muted small mb-1">Assignments</p>
                        <p class="fs-3 fw-semibold mb-0">
                            <%= assignments.length %>
                        </p>
                    </div>
                </div>
            </div>
        </div>



        <div class="card border shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h6 fw-semibold mb-0">Classification officers</h2>
                    <a href="/registry/officers/add" class="btn btn-primary btn-sm">+ Add officer</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th scope="col">Name</th>
                                <th scope="col">Email</th>
                                <th scope="col">Assigned to</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="table-group-divider">
                            <% officers.forEach(officer=> { %>
                                <tr>
                                    <td>
                                        <%= officer.name %>
                                    </td>
                                    <td>
                                        <%= officer.email %>
                                    <td>
                                        <% if (officer.degree_name) { %>
                                            <span class="badge bg-primary">
                                                <%= officer.degree_name %>
                                            </span>
                                            <% } else { %>
                                                <span class="text-muted small">Unassigned</span>
                                                <% } %>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a href="/registry/officers/<%= officer.id %>/edit"
                                                class="btn btn-outline-secondary btn-sm">Edit</a>
                                            <form action="/registry/officers/<%= officer.id %>/delete" method="post"
                                                class="d-inline">
                                                <button class="btn btn-outline-danger btn-sm">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>

                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card border shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h6 fw-semibold mb-0">Degree programs</h2>
                    <a href="/registry/degrees/add" class="btn btn-primary btn-sm">+ Add degree</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th scope="col">Degree</th>
                                <th scope="col">Yr2 Weighting</th>
                                <th scope="col">Yr3 Weighting</th>
                                <th scope="col">Credits per year</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="table-group-divider">
                            <% degrees.forEach(degree=> { %>
                                <tr>
                                    <td>
                                        <%= degree.name %>
                                    </td>
                                    <td>
                                        <%= degree.weighting_yr2 %>
                                    <td>
                                        <%= degree.weighting_yr3 %>
                                    </td>
                                    <td>
                                        <%= degree.credits_per_year %>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a href="/registry/degrees/<%= degree.id %>/edit"
                                                class="btn btn-outline-secondary btn-sm">Edit</a>
                                            <form action="/registry/degrees/<%= degree.id %>/delete" method="post"
                                                class="d-inline">
                                                <button class="btn btn-outline-danger btn-sm">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</body>

</html>